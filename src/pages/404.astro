---
import Base from '../layouts/Base.astro';
import Related from '../components/Related.astro';
---

<Base
  title="Page Not Found | HearMyMic"
  description="This page doesn’t exist. Head back to the free online mic test."
  path="/404"
  noindex
>
  <div class="container-page">
    <div class="mx-auto max-w-xl py-16 text-center sm:py-24">
      <p class="text-base font-semibold text-accent-ink">404</p>
      <h1 class="mt-2 text-4xl font-extrabold leading-[1.08] sm:text-5xl">This page isn’t here</h1>
      <p class="mt-4 text-muted">
        The link may be old or mistyped. Your mic is probably fine, though, and you can check it in a few seconds.
      </p>
      <p class="mt-8">
        <a href="/" class="btn btn-primary btn-lg">Go to the mic test</a>
      </p>
    </div>
    <Related
      title="Popular pages"
      slugs={['', 'mic-test-with-playback', 'webcam-and-mic-test', 'fix/mic-not-working', 'zoom-mic-test', 'discord-mic-test']}
    />
  </div>
</Base>
