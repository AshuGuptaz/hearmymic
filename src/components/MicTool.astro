---
/**
 * The mic test tool. The same markup and the same script run on every page;
 * `variant="camera"` adds a live video preview next to the level meter.
 *
 * All three views (idle, live, error) are stacked in one grid cell, so the
 * card keeps one height and switching state never shifts the page.
 */
import Icon from './Icon.astro';
import { defaultLocale, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { hasTranslation, pathFor } from '../i18n/routes';

interface Props {
  variant?: 'mic' | 'camera';
  locale?: Locale;
}
const { variant = 'mic', locale = defaultLocale } = Astro.props;
const { tool: t, toolJs } = ui[locale];
const cam = variant === 'camera';
// Error buttons link to the fix guide in this language when one exists, otherwise to the English one.
const fixLink = (slug: string) => pathFor(hasTranslation(locale, slug) ? locale : defaultLocale, slug);
const fixLinks = {
  'mic-not-working': fixLink('fix/mic-not-working'),
  'mic-permission-blocked': fixLink('fix/mic-permission-blocked'),
};
const startLabel = cam ? t.startCam : t.startMic;

const info = [
  { key: 'device', label: t.info.device },
  ...(cam
    ? [
        { key: 'camera', label: t.info.camera },
        { key: 'resolution', label: t.info.resolution },
      ]
    : []),
  { key: 'sampleRate', label: t.info.sampleRate },
  { key: 'channels', label: t.info.channels },
  { key: 'echo', label: t.info.echo },
  { key: 'noise', label: t.info.noise },
  { key: 'agc', label: t.info.agc },
  { key: 'latency', label: t.info.latency },
  { key: 'rating', label: t.info.rating },
];
---

<section
  id="tool"
  data-tool
  data-variant={variant}
  data-strings={JSON.stringify(toolJs)}
  data-fix-links={JSON.stringify(fixLinks)}
  aria-labelledby="tool-title"
  class:list={[
    'mx-auto w-full rounded-tool border border-border bg-surface shadow-tool',
    cam ? 'max-w-4xl' : 'max-w-3xl',
  ]}
>
  <h2 id="tool-title" class="sr-only">{cam ? t.titleCam : t.titleMic}</h2>
  <p data-status role="status" aria-live="polite" class="sr-only"></p>

  <div class="tool-stage p-5 sm:p-8">
    <!-- Idle -->
    <div data-view="idle" class="tool-view is-active flex flex-col items-center justify-center text-center">
      <div
        aria-hidden="true"
        class="mb-6 grid size-24 place-items-center rounded-full bg-accent-soft text-accent-ink sm:size-28"
      >
        <Icon name={cam ? 'video' : 'mic'} class="size-11 sm:size-12" />
      </div>
      <button type="button" data-action="start" data-focus class="btn btn-primary btn-lg">
        <span data-start-spinner class="spinner hidden" aria-hidden="true"></span>
        <span data-start-label data-default={startLabel}>{startLabel}</span>
      </button>
      <p data-idle-hint class="mt-4 min-h-[3.2em] max-w-sm text-[0.9375rem] leading-snug text-muted">
        {t.idleHint[0]}<strong class="font-semibold text-text">{t.idleHint[1]}</strong>{t.idleHint[2]}
      </p>
      <p class="mt-2 inline-flex items-center gap-2 text-[0.9375rem] font-medium text-text">
        <Icon name="lock" class="size-4 text-ok" />
        {t.privacy}
      </p>
      <noscript>
        <p class="mt-4 text-[0.9375rem] text-danger">{t.noscript}</p>
      </noscript>
    </div>

    <!-- Live -->
    <div data-view="live" class="tool-view" inert>
      <div class="flex items-center gap-3">
        <button
          type="button"
          data-action="stop"
          aria-label={t.stopAria}
          class="mic-live grid size-12 flex-none cursor-pointer place-items-center rounded-full bg-accent text-white"
        >
          <Icon name="mic" class="relative size-6" />
        </button>
        <div class="min-w-0 flex-1">
          <p data-live-title data-focus tabindex="-1" class="flex items-center gap-2 text-base font-semibold leading-tight outline-none">
            <span data-live-check class="grid size-5 place-items-center rounded-full bg-ok text-surface">
              <Icon name="check" class="size-3.5" />
            </span>
            <span>{t.workingTitle}</span>
          </p>
          <p data-live-device class="truncate text-[0.9375rem] text-muted">{t.listeningInit}</p>
        </div>
        <button type="button" data-action="stop" class="btn btn-quiet flex-none">{t.stop}</button>
      </div>

      <div class:list={['mt-5 grid gap-5', cam && 'md:grid-cols-2 md:items-start']}>
        {
          cam && (
            <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-border bg-surface-2">
              <video
                data-video
                class="size-full -scale-x-100 object-cover"
                width="640"
                height="480"
                muted
                playsinline
                aria-label={t.videoAria}
              />
              <p
                data-video-note
                class="absolute inset-0 hidden place-content-center gap-2 p-6 text-center text-[0.9375rem] text-muted"
              />
            </div>
          )
        }

        <div class="min-w-0">
          <canvas
            data-wave
            aria-hidden="true"
            class="block h-24 w-full rounded-2xl border border-border bg-surface-2"
            width="600"
            height="112"></canvas>

          <div class="mt-4 flex items-center gap-3">
            <div
              data-meter
              role="meter"
              aria-label={t.meterAria}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              class="meter-track flex-1"
            >
              <div class="meter-fill"></div>
              <div data-meter-cover class="meter-cover"></div>
              <div data-meter-peak class="meter-peak"></div>
            </div>
            <span data-db class="w-[4.5rem] flex-none text-right text-[0.9375rem] tabular-nums text-muted">–∞&nbsp;dB</span>
          </div>

          <p class="mt-3 flex min-h-[4.3em] items-start gap-2 text-[0.9375rem] leading-snug text-muted">
            <span
              data-rating
              class="flex-none rounded-full border border-border bg-surface-2 px-2.5 py-0.5 text-[0.8125rem] font-semibold text-text"
              >{t.ratingInit}</span
            >
            <span data-rating-hint>{t.ratingHintInit}</span>
          </p>
        </div>
      </div>

      <!-- Device pickers: space is always reserved so nothing jumps -->
      <div class="mt-1 grid gap-3 sm:grid-cols-2">
        <label data-mic-select-wrap class="text-[0.9375rem]">
          <span class="mb-1 block font-medium">{t.microphone}</span>
          <select
            data-mic-select
            name="microphone"
            autocomplete="off"
            class="h-11 w-full min-w-0 rounded-xl border border-border bg-surface px-3 text-base"></select>
        </label>
        {
          cam && (
            <label data-cam-select-wrap class="text-[0.9375rem]">
              <span class="mb-1 block font-medium">{t.camera}</span>
              <select
                data-cam-select
                name="camera"
                autocomplete="off"
                class="h-11 w-full min-w-0 rounded-xl border border-border bg-surface px-3 text-base"
              />
            </label>
          )
        }
      </div>

    </div>

    <!-- Error -->
    <div data-view="error" class="tool-view flex flex-col items-center justify-center text-center" inert>
      <div aria-hidden="true" class="mb-5 grid size-20 place-items-center rounded-full bg-surface-2 text-danger">
        <Icon name="mic-off" class="size-9" />
      </div>
      <h3 data-error-title data-focus tabindex="-1" class="text-2xl font-bold outline-none">{t.errorTitle}</h3>
      <p data-error-body class="mt-2 max-w-md text-muted"></p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <button type="button" data-action="retry" class="btn btn-primary">{t.retry}</button>
        <a data-error-link href="/fix/mic-not-working" class="btn btn-quiet">{t.seeFix}</a>
      </div>
    </div>
  </div>

  <!-- Record + live monitor: always rendered (disabled until the test is live)
       so starting the test never changes the height of the card. -->
    <div class="grid gap-4 border-t border-border px-5 py-5 sm:px-8 sm:py-6 md:grid-cols-2">
      <!-- Record and play back -->
      <div class="rounded-2xl border border-border p-4">
        <div class="flex items-center gap-4">
          <div class="relative size-14 flex-none" aria-hidden="true">
            <svg viewBox="0 0 56 56" class="size-14 -rotate-90">
              <circle cx="28" cy="28" r="25" fill="none" stroke="var(--border)" stroke-width="4"></circle>
              <circle
                data-ring
                cx="28"
                cy="28"
                r="25"
                fill="none"
                stroke="var(--danger)"
                stroke-width="4"
                stroke-linecap="round"
                stroke-dasharray="157.08"
                stroke-dashoffset="157.08"></circle>
            </svg>
            <span data-count class="absolute inset-0 grid place-items-center text-lg font-bold tabular-nums">
              <span class="size-4 rounded-full bg-danger"></span>
            </span>
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold leading-tight">{t.recordTitle}</h3>
            <p data-record-hint class="text-[0.9375rem] leading-snug text-muted">
              {t.recordHint}
            </p>
          </div>
        </div>
        <button type="button" data-action="record" class="btn btn-quiet mt-4 w-full" disabled>{t.recordBtn}</button>
        <div class="mt-3 flex min-h-[54px] items-center">
          <p data-player-empty class="text-[0.875rem] text-muted">{t.recordEmpty}</p>
          <audio data-player controls preload="metadata" class="hidden h-[54px] w-full" aria-label={t.playerAria}
          ></audio>
        </div>
      </div>

      <!-- Hear yourself live -->
      <div class="rounded-2xl border border-border p-4">
        <div class="flex items-center gap-4">
          <div class="min-w-0 flex-1">
            <h3 id="monitor-label" class="font-semibold leading-tight">{t.monitorTitle}</h3>
            <p class="text-[0.9375rem] leading-snug text-muted">{t.monitorDesc}</p>
          </div>
          <span class="grid min-h-11 place-items-center">
            <button
              type="button"
              role="switch"
              aria-checked="false"
              aria-labelledby="monitor-label"
              aria-describedby="monitor-warning"
              data-action="monitor"
              disabled
              class="switch"></button>
          </span>
        </div>
        <p
          id="monitor-warning"
          class="mt-4 flex items-start gap-2 rounded-xl bg-surface-2 p-3 text-[0.875rem] leading-snug text-text"
        >
          <Icon name="headphones" class="mt-0.5 size-4 flex-none text-warn" />
          <span>{t.monitorWarning}</span>
        </p>
      </div>
    </div>

  <!-- Info panel: always rendered so filling it in never moves the page -->
  <div class="border-t border-border px-5 py-5 sm:px-8 sm:py-6">
    <h3 class="text-base font-semibold">{cam ? t.infoTitleCam : t.infoTitleMic}</h3>
    <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-3 text-[0.9375rem] sm:grid-cols-4">
      {
        info.map((row) => (
          <div class:list={['min-w-0', (row.key === 'device' || row.key === 'camera') && 'col-span-2']}>
            <dt class="text-[0.8125rem] text-muted">{row.label}</dt>
            <dd data-info={row.key} class="truncate font-medium tabular-nums">
              —
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-4 text-[0.8125rem] leading-snug text-muted">
      {t.disclaimer}
    </p>
  </div>
</section>

<script>
  import '../scripts/boot';
</script>
